# Copie este arquivo para .env antes de executar a aplicação.
# O arquivo .env real é ignorado pelo Git para proteger credenciais.

# Endereço do protocolo Bolt usado pela aplicação para conversar com o Neo4j.
NEO4J_URI=bolt://localhost:7687

# Devem corresponder ao valor de NEO4J_AUTH definido no docker-compose.yml.
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Modelo local usado para gerar os embeddings.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
