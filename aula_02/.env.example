# Endereço usado pela API Node.js para acessar o PostgreSQL/pgvector local.
# Copie para `.env` somente se quiser trocar os valores padrão do server.js.
DATABASE_URL=postgresql://recommendations:recommendations@localhost:5434/recommendations
# Porta publicada pelo Docker no computador. Dentro do container permanece 5432.
PGVECTOR_PORT=5434
PORT=3100
